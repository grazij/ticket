#!/usr/bin/env bash
# tk-plugin: Open ticket in $EDITOR
# tk-plugin-version: 1.0.5
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "Usage: tk edit <id>" >&2
    exit 1
fi

id="$1"
read -r id <<< "$id"

# Dispatch passes an explicit TICKETS_DIR through unvalidated (a plugin may be
# the one that creates it), so a read-only plugin that resolves against it
# must check for itself rather than failing with no message (find on a
# missing directory would otherwise abort the script silently under -e).
if [[ -n "${TICKETS_DIR:-}" && ! -d "$TICKETS_DIR" ]]; then
    echo "Error: tickets directory '$TICKETS_DIR' does not exist" >&2
    exit 1
fi

# An ID names one file inside TICKETS_DIR, so a separator or parent reference
# can only be an attempt to escape it. Same rule as the core ticket_path().
if [[ "$id" == */* || "$id" == *..* ]]; then
    echo "Error: invalid ticket ID '$id' (must not contain '/' or '..')" >&2
    exit 1
fi

# Resolve ticket file (exact or partial match). $id is matched as a literal
# substring of the basename, not as a find/fnmatch pattern -- otherwise a
# caller-supplied ID containing *, ? or [...] would be interpreted as a glob
# instead of matched literally.
file="$TICKETS_DIR/${id}.md"
if [[ ! -f "$file" ]]; then
    matches=$(find -L "$TICKETS_DIR" -maxdepth 1 -name '*.md' 2>/dev/null | awk -v id="$id" '
        {
            n = split($0, parts, "/")
            if (index(parts[n], id) > 0) print
        }
    ')
    count=$(printf '%s\n' "$matches" | grep -c . 2>/dev/null || true)
    if [[ "$count" -eq 1 ]]; then
        file="$matches"
    elif [[ "$count" -gt 1 ]]; then
        echo "Error: ambiguous ID '$id' matches multiple tickets" >&2
        exit 1
    else
        echo "Error: ticket '$id' not found" >&2
        exit 1
    fi
fi

if [ -t 0 ] && [ -t 1 ]; then
    # EDITOR is a command line, not a bare path: it may carry flags
    # (EDITOR="code -w"). Quoting it whole breaks those; leaving it unquoted
    # breaks a path containing spaces. eval handles both, and a user with a
    # spaced path quotes it themselves (EDITOR="'/My Apps/ed' --wait"), which
    # is the convention git and crontab already use.
    eval "${EDITOR:-vi}" '"$file"'
else
    echo "Edit ticket file: $file"
fi
